{"id": "ld-01", "group": "loop_dedup", "description": "A duplicate webhook delivery is processed once", "steps": [{"body": "What are your opening hours?", "deliveries": 2, "expect": {"reply": "sent", "duplicates": 1, "outbox": 1}}]}
{"id": "ld-02", "group": "loop_dedup", "description": "Self-echo from the business's own number is skipped", "steps": [{"body": "Thanks for contacting Harbor Dental!", "from": "+15550190001", "expect": {"reply": "none", "skip": "self_echo", "outbox": 0}}]}
{"id": "ld-03", "group": "loop_dedup", "description": "A bot-to-bot loop is caught by the loop breaker", "steps": [{"body": "Thank you for your message! Your ticket number is 1001. Reply STOP to opt out.", "atMs": 0, "from": "+15550777000", "expect": {"reply": "sent"}}, {"body": "Thank you for your message! Your ticket number is 1002. Reply STOP to opt out.", "atMs": 2000, "from": "+15550777000", "expect": {"reply": "sent"}}, {"body": "Thank you for your message! Your ticket number is 1003. Reply STOP to opt out.", "atMs": 4000, "from": "+15550777000", "expect": {"reply": "draft", "skip": "loop_detected", "outbox": 2, "drafts": 1}}]}
{"id": "ld-04", "group": "loop_dedup", "description": "The per-sender rate limit turns into a drafted handoff", "rateLimitMax": 3, "steps": [{"body": "What are your opening hours?", "atMs": 0, "expect": {"reply": "sent"}}, {"body": "What services do you offer?", "atMs": 30000, "expect": {"reply": "sent"}}, {"body": "Where are you located?", "atMs": 60000, "expect": {"reply": "sent"}}, {"body": "Do you offer whitening?", "atMs": 90000, "expect": {"reply": "draft", "skip": "rate_limited", "outbox": 3, "drafts": 1}}]}
{"id": "ld-05", "group": "loop_dedup", "description": "A row stuck in processing is reclaimed and answered", "steps": [{"body": "Which services do you offer?", "stuck": true, "expect": {"reply": "sent", "reclaimed": 1, "outbox": 1}}]}
